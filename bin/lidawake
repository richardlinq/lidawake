#!/bin/bash
# lidawake — keep your MacBook working with the lid closed.
#
# The switch that matters is the kernel-level SleepDisabled flag
# (`sudo pmset -a disablesleep 1`). `caffeinate` only blocks *idle* sleep;
# it does not block clamshell sleep, which is a separate path.
#
# Keep Running policy:
#   on AC power                  -> hold (battery level ignored)
#   on battery, level >= threshold -> hold
#   on battery, level <  threshold -> release, normal sleep returns
# A background daemon maintains this. You never have to remember anything.
#
# Trade-off: with SleepDisabled=1 macOS also stops turning the display off
# by itself (measured: both `pmset displaysleepnow` and the `displaysleep`
# idle timer are inert in this state). So on lid close we dim the backlight
# ourselves via `dispbright`, and optionally lock the screen.

export PATH=/usr/bin:/bin:/usr/sbin:/sbin
set -u   # deliberately NOT pipefail: `cmd | grep -q` closes the pipe early,
         # the producer takes SIGPIPE, and every boolean test silently inverts.

LABEL="cc.openq.lidawake"
STATE="$HOME/.local/state/lidawake"; mkdir -p "$STATE"
MODEF="$STATE/mode"; THRF="$STATE/threshold"; LOG="$STATE/lidawake.log"
BLANKF="$STATE/blank_on_shut"; SAVEB="$STATE/saved_brightness"; LOCKF="$STATE/lock_on_shut"
FLOORF="$STATE/hard_floor"; CALF="$STATE/calibration.txt"; RUNF="$STATE/run_owner"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
POLL=10

BRIGHT="$(dirname "$SELF")/dispbright"
[ -x "$BRIGHT" ] || BRIGHT="$(command -v dispbright 2>/dev/null || printf '%s' "$BRIGHT")"

[ -f "$THRF" ]   || echo 20   > "$THRF"
[ -f "$MODEF" ]  || echo auto > "$MODEF"
[ -f "$BLANKF" ] || echo 1    > "$BLANKF"
[ -f "$LOCKF" ]  || echo 1    > "$LOCKF"
# Conservative default until `lidawake calibrate` measures this machine.
[ -f "$FLOORF" ] || echo 5    > "$FLOORF"
floor(){ cat "$FLOORF" 2>/dev/null || echo 5; }
# User reserve, never allowed below the measured hard floor.
thr(){ local u f; u=$(cat "$THRF" 2>/dev/null || echo 20); f=$(floor)
       [ "$u" -lt "$f" ] && echo "$f" || echo "$u"; }
mode(){ cat "$MODEF" 2>/dev/null || echo auto; }
blank_on(){ cat "$BLANKF" 2>/dev/null || echo 1; }
lock_on(){ cat "$LOCKF" 2>/dev/null || echo 1; }
# Locking is a pure UI state. It does not pause any computation.
do_lock(){ /usr/bin/python3 -c 'import ctypes;ctypes.CDLL("/System/Library/PrivateFrameworks/login.framework/login").SACLockScreenImmediate()' >/dev/null 2>&1; }

log(){ printf '%s  %s\n' "$(date '+%m-%d %H:%M:%S')" "$*" >> "$LOG"; }
notify(){ # notify <title> <body> [sound]
  local t b
  t=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
  b=$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')
  osascript -e "display notification \"$b\" with title \"$t\"${3:+ sound name \"$3\"}" >/dev/null 2>&1 || true
}

is_on(){ [ "$(ioreg -c IOPMrootDomain -r -d 1 2>/dev/null | awk -F'= ' '/"SleepDisabled"/{print $2; exit}')" = "Yes" ]; }
on_ac(){ case "$(pmset -g batt 2>/dev/null)" in *"'AC Power'"*) return 0;; *) return 1;; esac; }
batt(){ pmset -g batt 2>/dev/null | grep -oE '[0-9]+%' | head -1 | tr -d '%'; }
lid(){ [ "$(ioreg -c IOPMrootDomain -r -d 1 2>/dev/null | awk -F'= ' '/AppleClamshellState/{print $2; exit}')" = "Yes" ] && echo SHUT || echo OPEN; }

dim_down(){
  [ -x "$BRIGHT" ] || return 1
  local b; b=$("$BRIGHT" 2>/dev/null); [ -z "$b" ] && return 1
  printf '%s\n' "$b" > "$SAVEB"
  local lk=""
  if [ "$(lock_on)" = 1 ]; then do_lock; lk=", screen locked"; fi
  "$BRIGHT" 0.0 >/dev/null 2>&1
  log "lid shut -> brightness $b -> 0${lk}"
}
dim_restore(){
  local b; b=$(cat "$SAVEB" 2>/dev/null); rm -f "$SAVEB"
  [ -z "$b" ] && return 0
  [ -x "$BRIGHT" ] && "$BRIGHT" "$b" >/dev/null 2>&1
  log "${1:-restore} -> brightness back to $b"
}

sudo_ok(){ sudo -n /usr/bin/pmset -g >/dev/null 2>&1; }
_hw(){ sudo -n /usr/bin/pmset -a disablesleep "$1" >/dev/null 2>&1; }
need_sudo(){ sudo_ok || { echo "error: passwordless pmset rule missing. Run ./install.sh (see README)." >&2; exit 1; }; }
ensure(){ # ensure <0|1> <reason> [quiet]  — acts only when the state differs
  if [ "$1" = 1 ]; then is_on && return 0; _hw 1; log "-> holding ($2)"; [ "${3:-}" = quiet ] || notify "lidawake: holding" "$2"
  else is_on || return 0; _hw 0; log "-> released ($2)"; [ "${3:-}" = quiet ] || notify "lidawake: released" "$2"; fi
}

should_hold(){   # echoes the reason to hold; empty string means do not hold
  local b; b=$(batt)
  if on_ac; then echo "on AC power"; return; fi
  if [ -n "${b:-}" ] && [ "$b" -ge "$(thr)" ]; then echo "battery ${b}% (threshold $(thr)%)"; return; fi
  echo ""
}

_daemon(){
  log "daemon started (threshold $(thr)%)"
  # Safety: lid open but a saved brightness lingers -> last restore never ran.
  [ "$(lid)" = OPEN ] && [ -f "$SAVEB" ] && dim_restore "daemon startup recovery"
  while :; do
    # An abandoned `run` wrapper would otherwise pin the machine awake forever.
    if [ "$(mode)" = forced ] && [ -f "$RUNF" ]; then
      local owner prev
      read -r owner prev < "$RUNF"
      if [ -n "${owner:-}" ] && ! kill -0 "$owner" 2>/dev/null; then
        rm -f "$RUNF"; echo "${prev:-auto}" > "$MODEF"
        log "run wrapper (pid $owner) vanished -> mode restored to ${prev:-auto}"
        notify "lidawake" "A run wrapper exited without cleaning up; mode restored to ${prev:-auto}"
      fi
    fi
    case "$(mode)" in
      paused) ensure 0 "manually paused" quiet ;;
      forced) ensure 1 "forced on" quiet ;;
      *)      local r; r=$(should_hold)
              if [ -n "$r" ]; then ensure 1 "$r"; else ensure 0 "battery $(batt)% below threshold $(thr)%"; fi ;;
    esac
    if [ "$(blank_on)" = 1 ]; then
      if [ "$(lid)" = SHUT ] && is_on; then
        [ -f "$SAVEB" ] || dim_down
      else
        [ -f "$SAVEB" ] && dim_restore "lid opened or hold released"
      fi
    fi
    # While dimmed, poll the lid every second so the restore feels instant.
    # Otherwise idle at POLL seconds so we are not burning power ourselves.
    if [ -f "$SAVEB" ]; then
      local i=0
      while [ "$i" -lt "$POLL" ]; do
        if [ "$(lid)" = OPEN ]; then dim_restore "lid opened"; break; fi
        i=$((i+1)); sleep 1
      done
    else
      sleep "$POLL"
    fi
  done
}

# ── Measure this machine and derive its hard floor ──────────────────────────
# The floor answers one question only: below what charge is there no longer
# enough runway to release the hold and complete a safe sleep before the
# battery is empty? Everything above that is user preference, not safety.
_bstat(){  # -> "maxmAh curmAh amperage_mA voltage_mV designmAh"
  ioreg -rc AppleSmartBattery 2>/dev/null | /usr/bin/python3 -c '
import sys
t = sys.stdin.read()
def g(k):
    for line in t.splitlines():
        if "\"" + k + "\"" in line and "=" in line:
            v = line.split("=")[-1].strip()
            if v.lstrip("-").isdigit(): return int(v)
    return 0
def sgn(v): return v - 2**64 if v > 2**63 else v
print(g("AppleRawMaxCapacity"), g("AppleRawCurrentCapacity"),
      sgn(g("InstantAmperage")), g("Voltage"), g("DesignCapacity"))'
}

_calibrate(){
  command -v /usr/bin/python3 >/dev/null || { echo "python3 required" >&2; return 1; }
  if on_ac; then
    echo "Unplug the power adapter first — discharge rate cannot be measured on AC."
    return 1
  fi
  local mx cur amp volt des
  read -r mx cur amp volt des <<<"$(_bstat)"
  [ "${mx:-0}" -gt 0 ] || { echo "could not read battery telemetry" >&2; return 1; }

  echo "Calibrating this machine. Takes about 30 seconds, fans/CPU will spin up."
  echo
  printf 'Battery   : %s mAh full (design %s mAh, health %s%%), %s mV\n' \
    "$mx" "$des" "$(( mx * 100 / (des>0?des:1) ))" "$volt"

  # --- worst-case draw: load every core, sample, keep the largest ---
  local n pids=() i a peak=0
  n=$(sysctl -n hw.ncpu)
  for i in $(seq 1 "$n"); do yes > /dev/null & pids+=($!); done
  sleep 8
  for i in 1 2 3 4 5 6; do
    read -r _ _ a _ _ <<<"$(_bstat)"
    a=${a#-}; [ "${a:-0}" -gt "$peak" ] && peak=$a
    sleep 2
  done
  kill "${pids[@]}" 2>/dev/null; wait "${pids[@]}" 2>/dev/null
  # A safety floor may only ratchet up. Draw depends on what else happened to
  # be running, so a quieter re-run must not erase a worse case we already saw.
  local prevpeak=0 note=""
  [ -f "$STATE/peak_ma" ] && prevpeak=$(cat "$STATE/peak_ma" 2>/dev/null || echo 0)
  if [ "$prevpeak" -gt "$peak" ]; then
    note="  (keeping earlier worse case; this run measured ${peak} mA)"; peak=$prevpeak
  else
    echo "$peak" > "$STATE/peak_ma"
  fi
  printf 'Peak draw : %s mA on %s cores = %s W%s\n' "$peak" "$n" \
    "$(/usr/bin/python3 -c "print(round($peak*$volt/1e6,1))")" "$note"

  # --- how long a safe sleep takes: hibernate image / disk throughput ---
  local img spd
  img=$(stat -f%z /var/vm/sleepimage 2>/dev/null || echo 0)
  spd=$(dd if=/dev/zero of=/tmp/.lidawake_spd bs=1m count=256 2>&1 | awk -F'[( ]' '/bytes/{print $(NF-1)}')
  rm -f /tmp/.lidawake_spd
  [ "${spd:-0}" -gt 0 ] || spd=500000000
  printf 'Sleep img : %s MB, disk %s MB/s\n' "$((img/1048576))" "$((spd/1048576))"

  # --- derive ---
  local out
  out=$(/usr/bin/python3 - "$peak" "$mx" "$img" "$spd" "$POLL" <<'PY'
import sys, math
peak, mx, img, spd, poll = (int(float(x)) for x in sys.argv[1:6])
rate = peak / mx * 100 / 60            # %/min at peak draw
t_write = (img / spd) * 2 if img else 10   # 2x margin: hibernate write is not pure sequential
t_total = poll + t_write + 5           # detect + write + fixed overhead
need = t_total / 60 * rate             # % consumed while shutting down
SAFETY = 3                             # discharge-rate uncertainty under bursty load
# The arithmetic above models discharge rate and shutdown time only. It does
# NOT model state-of-charge gauge error, which is largest near empty and can
# be several points on an aged cell — a reported 2% may really be 0%. The 5%
# lower clamp encodes that; it is not derived, and it is deliberately the
# binding constraint on healthy machines.
GAUGE_CLAMP = 5
floor = max(GAUGE_CLAMP, min(15, math.ceil(need * SAFETY)))
print(f"{rate:.2f} {t_write:.1f} {t_total:.1f} {need:.2f} {SAFETY} {floor} {math.ceil(need*SAFETY)}")
PY
)
  local rate twrite ttotal need safety newfloor derived
  read -r rate twrite ttotal need safety newfloor derived <<<"$out"

  echo
  echo "Derivation"
  printf '  discharge at peak load     %s %%/min\n' "$rate"
  printf '  detect (poll interval)     %s s\n' "$POLL"
  printf '  write hibernate image      %s s  (2x margin)\n' "$twrite"
  printf '  + fixed overhead           5 s\n'
  printf '  --------------------------------\n'
  printf '  time to sleep safely       %s s\n' "$ttotal"
  printf '  charge consumed in that    %s %%\n' "$need"
  printf '  x safety factor            %s\n' "$safety"
  printf '  --------------------------------\n'
  printf '  derived from discharge     %s %%\n' "$derived"
  printf '  gauge-error clamp          5 %% (not derived — see note)\n'
  printf '  ================================\n'
  printf '  HARD FLOOR                 %s %%\n' "$newfloor"

  echo "$newfloor" > "$FLOORF"
  { date '+calibrated %Y-%m-%d %H:%M'
    printf 'battery %s/%s mAh (%s%%), %s mV\n' "$mx" "$des" "$(( mx*100/(des>0?des:1) ))" "$volt"
    printf 'peak draw %s mA, discharge %s %%/min\n' "$peak" "$rate"
    printf 'sleep image %s MB, disk %s MB/s, write %s s\n' "$((img/1048576))" "$((spd/1048576))" "$twrite"
    printf 'time to sleep safely %s s, consumes %s %%, safety x%s\n' "$ttotal" "$need" "$safety"
    printf 'hard floor %s%%\n' "$newfloor"
  } > "$CALF"

  local u; u=$(cat "$THRF" 2>/dev/null || echo 20)
  echo
  if [ "$u" -lt "$newfloor" ]; then
    echo "Your reserve ($u%) is below the new floor — raising it to ${newfloor}%."
    echo "$newfloor" > "$THRF"
  elif [ "$u" -eq "$newfloor" ]; then
    printf 'Your reserve (%s%%) sits exactly on the floor.\n' "$u"
    echo "  Safety-wise that is fine. But it also means you arrive with a flat"
    echo "  battery, and repeated deep discharge shortens cell life. Raising the"
    echo "  reserve costs you runway; that trade is yours: lidawake threshold N"
  else
    printf 'Your reserve stays at %s%%; the floor is %s%%.\n' "$u" "$newfloor"
    printf '  Safety only needs %s%%. The other %s points buy charge left on arrival\n' "$newfloor" "$((u-newfloor))"
    echo "  and keep the cell out of deep discharge — a longevity question, not a safety one."
  fi
  echo "Saved to $CALF"
}

daemon_running(){ case "$(launchctl list 2>/dev/null)" in *"$LABEL"*) return 0;; *) return 1;; esac; }

install_daemon(){
  mkdir -p "$(dirname "$PLIST")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>$SELF</string><string>__daemon</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>$STATE/daemon.err</string>
</dict></plist>
EOF
  launchctl unload "$PLIST" 2>/dev/null
  launchctl load "$PLIST" 2>/dev/null
}

case "${1:-status}" in
  auto|custom)
    need_sudo; echo auto > "$MODEF"; install_daemon
    echo "Keep Running enabled."
    echo "  on AC -> hold; on battery >= $(thr)% -> hold; below -> release"
    sleep 2; "$SELF" status ;;
  on)
    need_sudo; echo forced > "$MODEF"; daemon_running || install_daemon
    ensure 1 "forced on"
    echo "Forced on (battery level ignored). Back to automatic: lidawake auto" ;;
  off|normal)
    need_sudo; echo paused > "$MODEF"; ensure 0 "manually turned off"
    echo "Let It Sleep — lid close sleeps, exactly like stock macOS."
    echo "  Switch back with: lidawake auto" ;;
  toggle)
    if [ "$(mode)" = auto ]; then exec "$SELF" normal; else exec "$SELF" auto; fi ;;
  lock)
    case "${2:-}" in
      on)  echo 1 > "$LOCKF"; echo "Lock on lid close: ON (unlock with Touch ID)" ;;
      off) echo 0 > "$LOCKF"; echo "Lock on lid close: OFF" ;;
      *)   echo "Lock on lid close: $([ "$(lock_on)" = 1 ] && echo ON || echo OFF)   (lidawake lock on|off)" ;;
    esac ;;
  blank)
    case "${2:-}" in
      on)  echo 1 > "$BLANKF"; echo "Dim backlight on lid close: ON" ;;
      off) echo 0 > "$BLANKF"; [ -f "$SAVEB" ] && dim_restore "feature disabled"; echo "Dim backlight on lid close: OFF" ;;
      *)   echo "Dim backlight on lid close: $([ "$(blank_on)" = 1 ] && echo ON || echo OFF)   (lidawake blank on|off)" ;;
    esac ;;
  threshold)
    if [ -n "${2:-}" ]; then
      f=$(floor)
      if [ "$2" -lt "$f" ]; then
        echo "Refused: $2% is below this machine's measured hard floor of ${f}%."
        echo "Below the floor there may not be enough runway to sleep safely before the"
        echo "battery is empty. Re-measure with: lidawake calibrate"
        exit 1
      fi
      echo "$2" > "$THRF"; echo "Reserve set to $2%  (hard floor ${f}%)"
    else
      echo "Reserve: $(cat "$THRF" 2>/dev/null || echo 20)%   hard floor: $(floor)%   effective: $(thr)%"
    fi ;;
  calibrate) _calibrate ;;
  status|st)
    m=$(mode)
    printf 'State   : %s\n' "$(is_on && echo 'holding — lid close keeps running' || echo 'not holding — lid close sleeps')"
    case "$m" in
      auto)   desc="Keep Running — hold on AC, or on battery >= $(thr)% (reserve $(cat "$THRF" 2>/dev/null||echo 20)%, floor $(floor)%)" ;;
      paused) desc="Let It Sleep — stock macOS behaviour" ;;
      forced) desc="Keep Running (forced) — hold regardless of battery" ;;
      *)      desc="$m" ;;
    esac
    printf 'Mode    : %s\n' "$desc"
    printf 'Power   : %s %s%%   Lid: %s   Brightness: %s\n' \
      "$(on_ac && echo 'AC' || echo 'battery')" "$(batt)" "$(lid)" "$([ -x "$BRIGHT" ] && "$BRIGHT" || echo '?')"
    printf 'On shut : dim=%s  lock=%s\n' \
      "$([ "$(blank_on)" = 1 ] && echo on || echo off)" "$([ "$(lock_on)" = 1 ] && echo on || echo off)"
    daemon_running && echo "Daemon  : running" || echo "Daemon  : not running (run: lidawake auto)" ;;
  run)
    shift; [ "${1:-}" = "--" ] && shift
    [ $# -eq 0 ] && { echo "usage: lidawake run -- <command>" >&2; exit 2; }
    pm=$(mode); label=$(printf '%s' "$*" | cut -c1-48)
    # Restore the previous mode even on Ctrl-C — otherwise an interrupted run
    # leaves the machine pinned in `forced` forever.
    # Two layers, because neither alone is enough:
    #  - the trap is the fast path, but bash will not run it while blocked on a
    #    foreground child, and it can never run under SIGKILL;
    #  - the owner marker lets the daemon notice an abandoned `forced` mode and
    #    put things back, whatever happened to this process.
    trap 'rm -f "$RUNF"; echo "$pm" > "$MODEF"' EXIT INT TERM
    printf '%s %s\n' "$$" "$pm" > "$RUNF"
    echo forced > "$MODEF"; ensure 1 "run wrapper" quiet
    t0=$(date +%s)
    "$@"; rc=$?
    el=$(( $(date +%s) - t0 ))
    if   [ "$el" -ge 3600 ]; then dur="$((el/3600))h $(((el%3600)/60))m"
    elif [ "$el" -ge 60 ];   then dur="$((el/60))m $((el%60))s"
    else                          dur="${el}s"; fi
    if [ "$rc" -eq 0 ]; then
      log "run finished: $label (exit 0, $dur)"
      notify "lidawake: finished" "$label — done in $dur" "Glass"
    else
      log "run FAILED: $label (exit $rc, $dur)"
      notify "lidawake: FAILED (exit $rc)" "$label — after $dur" "Basso"
    fi
    exit $rc ;;
  __daemon) _daemon ;;
  -h|--help|help|*) cat <<EOF
lidawake — keep your MacBook working with the lid closed

  Two modes, flip between them with toggle:

  lidawake auto          Keep Running — hold on AC, or on battery >= $(thr)%
  lidawake normal        Let It Sleep — stock macOS behaviour
  lidawake toggle        switch between the two

  lidawake on            force hold regardless of battery (temporary)
  lidawake status        show current state
  lidawake threshold 25  change the battery threshold
  lidawake blank on|off  dim the backlight on lid close (default on)
  lidawake lock  on|off  lock the screen on lid close (default on)
  lidawake run -- CMD    hold only while CMD runs, then restore and notify
  lidawake calibrate     measure this machine and derive its hard floor
EOF
  ;;
esac
